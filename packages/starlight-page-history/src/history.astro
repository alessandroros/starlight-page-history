---
// The history page of a docs page, at /<page>/history/: a timeline of every
// version, and what changed in the versions the reader picks on it. The page
// is built showing the latest change; timeline.js handles the rest.
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { getCollection } from 'astro:content';
import { diffPages } from './diff.js';
import { historyOf, historyUrl, pageSlug, settings } from './pages.js';
import { dotSizes } from './timeline-model.js';
import { formatDay, formatMoment, resultHtml } from './timeline-view.js';

export async function getStaticPaths() {
  const entries = await getCollection('docs');
  return entries.filter((entry) => historyOf(entry)).map((entry) => ({ params: { slug: pageSlug(entry.id) || undefined }, props: { entry } }));
}

const { entry } = Astro.props;
const { versions: all } = historyOf(entry);
const shownNewestFirst = settings.limit ? all.slice(0, settings.limit) : all;
const older = all.length - shownNewestFirst.length;
const root = older === 0;
const { t } = Astro.locals;
const lang = Astro.currentLocale ?? entry.data.lang ?? 'en';
const historyHref = historyUrl(entry);
const pageHref = historyHref.slice(0, -(settings.route.length + 1));

// Oldest first, each with what it changed since the version before
// (none for the first version of the page).
const versions = [...shownNewestFirst].reverse().map((version, index, list) => {
  const before = index > 0 ? list[index - 1] : all[shownNewestFirst.length];
  const stats = before ? diffPages(before.text, version.text).stats : null;
  return { sha: version.sha, date: version.date, author: version.author, subject: version.subject, stats };
});
const sizes = dotSizes(versions.map(({ stats }) => (stats ? stats.added + stats.changed + stats.removed : 0)));
const last = versions.length - 1;

// Labels, with {placeholders} and both plural forms for the browser to fill in.
const forms = (key, values = {}) => ({
  one: t(`${key}_one`, { count: '{count}', ...values }),
  other: t(`${key}_other`, { count: '{count}', ...values }),
});
const labels = {
  hidden: forms('pageHistory.unchanged'),
  added: forms('pageHistory.added'),
  changed: forms('pageHistory.changed'),
  removed: forms('pageHistory.removed'),
  changesBy: forms('pageHistory.changesBy', { authors: '{authors}' }),
  more: forms('pageHistory.more'),
  noChange: t('pageHistory.noChange'),
  noTextChange: t('pageHistory.noTextChange'),
  created: t('pageHistory.created'),
  firstVersion: t('pageHistory.firstVersion'),
  sinceFirst: t('pageHistory.sinceFirst'),
  changedOn: t('pageHistory.changedOn', { date: '{date}' }),
  changedBetween: t('pageHistory.changedBetween', { from: '{from}', to: '{to}' }),
  lastVisit: t('pageHistory.lastVisit'),
  error: t('pageHistory.error'),
  empty: {
    visit: t('pageHistory.presetFirstVisit'),
    visitNothingNew: t('pageHistory.presetNothingNew'),
    week: t('pageHistory.presetEmptyWeek'),
    month: t('pageHistory.presetEmptyMonth'),
  },
};
const presets = [
  ['visit', t('pageHistory.presetVisit')],
  ['latest', t('pageHistory.presetLatest')],
  ['week', t('pageHistory.presetWeek')],
  ['month', t('pageHistory.presetMonth')],
  ['all', t('pageHistory.presetAll')],
];

// Built showing the latest change.
const range = { start: last, end: last };
const baseText = last > 0 ? shownNewestFirst[1].text : all[shownNewestFirst.length]?.text;
const diff = baseText === undefined ? null : diffPages(baseText, shownNewestFirst[0].text);
const result = resultHtml({ versions, range, diff, labels, lang, commitUrl: settings.commitUrl, root });

const data = {
  versions,
  base: root ? null : all[shownNewestFirst.length].sha,
  labels,
  lang,
  commitUrl: settings.commitUrl,
  src: `${historyHref}versions.json`,
  key: historyHref,
};

// Dots, with a mark where a new day starts.
const items = versions.flatMap((version, index) => {
  const newDay = index === 0 || new Date(version.date).toDateString() !== new Date(versions[index - 1].date).toDateString();
  return [...(newDay ? [{ kind: 'day', label: formatDay(version.date, lang), first: index === 0 }] : []), { kind: 'dot', index, version }];
});
---

<StarlightPage
  frontmatter={{
    title: t('pageHistory.title', { title: entry.data.title }),
    description: t('pageHistory.description'),
    editUrl: false,
    pagefind: false,
    tableOfContents: false,
    lastUpdated: false,
    prev: false,
    next: false,
  }}
  headings={[]}
>
  <p class="ph-intro">
    <a href={pageHref}>← {entry.data.title}</a>
    <span>{t('pageHistory.versions', { count: all.length, date: formatDay(all.at(-1).date, lang) })}</span>
  </p>
  <div class="ph-history">
    <div class="ph-controls not-content">
      <div class="ph-presets" role="group" aria-label={t('pageHistory.period')}>
        {
          presets.map(([id, label]) => (
            <button type="button" class:list={['ph-chip', { 'ph-active': id === 'latest' }]} data-preset={id} disabled={id === 'visit'}>
              {label}
            </button>
          ))
        }
      </div>
      <div class="ph-timeline">
        <div class="ph-track" tabindex="0" role="group" aria-label={t('pageHistory.timeline')}>
          {
            items.map((item) =>
              item.kind === 'day' ? (
                <div class:list={['ph-day', { 'ph-first': item.first }]}>
                  <span>{item.label}</span>
                </div>
              ) : (
                <button
                  type="button"
                  class:list={['ph-dot', { 'ph-in ph-sel-start ph-sel-end': item.index === last, 'ph-origin': !item.version.stats }]}
                  data-i={item.index}
                  style={`--ph-r: ${sizes[item.index]}px`}
                  aria-pressed={item.index === last ? 'true' : 'false'}
                  aria-label={`${formatMoment(item.version.date, lang)}: ${item.version.subject}`}
                >
                  <span class="ph-pip" />
                </button>
              ),
            )
          }
        </div>
        <p class="ph-legend">
          <span>{t('pageHistory.hint')}</span>
          <span class="ph-legend-new">{t('pageHistory.legendNew')}</span>
          <span class="ph-legend-seen">{t('pageHistory.legendSeen')}</span>
          <span>{t('pageHistory.legendSize')}</span>
        </p>
        <div class="ph-tip" hidden />
      </div>
    </div>
    <section class="ph-result" aria-live="polite" set:html={result} />
    {older > 0 && <p class="ph-none">{t('pageHistory.older', { count: older })}</p>}
    <script type="application/json" class="ph-data" set:html={JSON.stringify(data).replace(/</g, '\\u003c')} />
  </div>
  <script>
    import './timeline.js';
  </script>
</StarlightPage>
